<?xml version="1.0"?>
<sdf version="1.8">

  <world name="fire_world">

    <!-- ====================== PHYSICS ====================== -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <gravity>0 0 -9.81</gravity>
    </physics>

    <!-- ====================== SCENE ====================== -->
    <scene>
      <ambient>0.6 0.6 0.7 1</ambient>
      <background>0.8 0.8 0.9 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- ====================== LIGHTING ====================== -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.8 1</diffuse>
      <specular>0.6 0.6 0.5 1</specular>
      <direction>-0.4 -0.4 -1</direction>
    </light>

    <!-- ====================== GROUND ====================== -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ====================== FIREBOT ROBOT ====================== -->
    <include>
      <uri>model://firebot</uri>
      <pose>-2 0 0.5 0 0 0</pose>
      <name>firebot</name>
    </include>

    <!-- ====================== ARENA WALLS ====================== -->
    <model name="arena_walls">

      <!-- LEFT WALL -->
      <model name="wall_left">
        <static>true</static>
        <pose>-4.1 0 0.5 0 0 0</pose>
        <link name="link">
          <collision name="collision">
            <geometry><box><size>0.2 8.4 1.0</size></box></geometry>
          </collision>
          <visual name="visual">
            <geometry><box><size>0.2 8.4 1.0</size></box></geometry>
            <material>
              <ambient>0.3 0.3 0.7 1</ambient>
              <diffuse>0.4 0.4 0.85 1</diffuse>
            </material>
          </visual>
        </link>
      </model>

      <!-- RIGHT WALL -->
      <model name="wall_right">
        <static>true</static>
        <pose>4.1 0 0.5 0 0 0</pose>
        <link name="link">
          <collision name="collision">
            <geometry><box><size>0.2 8.4 1.0</size></box></geometry>
          </collision>
          <visual name="visual">
            <geometry><box><size>0.2 8.4 1.0</size></box></geometry>
            <material>
              <ambient>0.3 0.3 0.7 1</ambient>
              <diffuse>0.4 0.4 0.85 1</diffuse>
            </material>
          </visual>
        </link>
      </model>

      <!-- TOP WALL -->
      <model name="wall_top">
        <static>true</static>
        <pose>0 4.1 0.5 0 0 0</pose>
        <link name="link">
          <collision name="collision">
            <geometry><box><size>8.4 0.2 1.0</size></box></geometry>
          </collision>
          <visual name="visual">
            <geometry><box><size>8.4 0.2 1.0</size></box></geometry>
            <material>
              <ambient>0.3 0.3 0.7 1</ambient>
              <diffuse>0.4 0.4 0.85 1</diffuse>
            </material>
          </visual>
        </link>
      </model>

      <!-- BOTTOM WALL -->
      <model name="wall_bottom">
        <static>true</static>
        <pose>0 -4.1 0.5 0 0 0</pose>
        <link name="link">
          <collision name="collision">
            <geometry><box><size>8.4 0.2 1.0</size></box></geometry>
          </collision>
          <visual name="visual">
            <geometry><box><size>8.4 0.2 1.0</size></box></geometry>
            <material>
              <ambient>0.3 0.3 0.7 1</ambient>
              <diffuse>0.4 0.4 0.85 1</diffuse>
            </material>
          </visual>
        </link>
      </model>

    </model>

    <!-- ====================== ROOM DIVIDERS (with Central Doorway) ====================== -->

    <!-- DIVIDER TOP -->
    <model name="divider_top">
      <static>true</static>
      <pose>0 1.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 2.5 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 2.5 1.0</size></box></geometry>
          <material>
            <ambient>0.45 0.25 0.25 1</ambient>
            <diffuse>0.75 0.35 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- DIVIDER BOTTOM -->
    <model name="divider_bottom">
      <static>true</static>
      <pose>0 -1.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 2.5 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 2.5 1.0</size></box></geometry>
          <material>
            <ambient>0.45 0.25 0.25 1</ambient>
            <diffuse>0.75 0.35 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ====================== OBSTACLES ====================== -->

    <!-- OBSTACLE 1 -->
    <model name="obstacle_1">
      <static>true</static>
      <link name="link">
        <pose>2 1 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box><size>0.5 0.5 0.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.5 0.5 0.5</size></box>
          </geometry>
          <material>
            <ambient>0.4 0.3 0.2 1</ambient>
            <diffuse>0.6 0.45 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- OBSTACLE 2 -->
    <model name="obstacle_2">
      <static>true</static>
      <link name="link">
        <pose>-2 -1 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box><size>0.5 0.5 0.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.5 0.5 0.5</size></box>
          </geometry>
          <material>
            <ambient>0.4 0.3 0.2 1</ambient>
            <diffuse>0.6 0.45 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ====================== FIRES ====================== -->

    <!-- FIRE 1 -->
    <model name="fire_1">
      <static>true</static>
      <link name="link">
        <pose>3 3 0.25 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.2</radius>
              <length>0.5</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1 0.3 0 1</ambient>
            <diffuse>1 0.2 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- FIRE 2 -->
    <model name="fire_2">
      <static>true</static>
      <link name="link">
        <pose>-3 -3 0.25 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.2</radius>
              <length>0.5</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1 0.3 0 1</ambient>
            <diffuse>1 0.2 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
