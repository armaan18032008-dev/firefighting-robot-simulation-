<?xml version="1.0"?>
<sdf version="1.8">
  <model name="firebot">

    <self_collide>false</self_collide>
    <static>false</static>

    <!--
    ═══════════════════════════════════════════════════════
     COORDINATE LAYOUT (side view):

     Ground = z=0
     Wheel center = z=0.05  (wheel radius = 0.05)
     Body center  = z=0.13  (body half-height 0.075 + wheel diameter 0.05 + gap 0.005)
     LiDAR center = z=0.26  (body top + lidar half 0.025 + small gap)
     Camera center= z=0.26  (same height as lidar, front offset)

     ALL link poses below are in the MODEL frame (absolute)
    ═══════════════════════════════════════════════════════
    -->

    <!-- ════════════════════════════════════════════════ -->
    <!--  BASE BODY                                       -->
    <!-- ════════════════════════════════════════════════ -->
    <link name="base_link">
      <pose>0 0 0.13 0 0 0</pose>

      <inertial>
        <mass>5.0</mass>
        <inertia>
          <ixx>0.0521</ixx>
          <iyy>0.0854</iyy>
          <izz>0.0854</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="body_visual">
        <geometry>
          <box><size>0.40 0.30 0.15</size></box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.9 1</ambient>
          <diffuse>0.1 0.1 0.9 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <collision name="body_collision">
        <geometry>
          <box><size>0.40 0.30 0.15</size></box>
        </geometry>
      </collision>
    </link>

    <!-- ════════════════════════════════════════════════ -->
    <!--  LEFT WHEEL                                      -->
    <!--                                                  -->
    <!--  Cylinder default axis = Z (vertical)            -->
    <!--  We rotate 90deg around X → cylinder axis = Y    -->
    <!--  This makes the wheel stand upright like a tyre  -->
    <!--  pose: x=0, y=+0.175 (left side), z=0.05 (ground level) -->
    <!-- ════════════════════════════════════════════════ -->
    <link name="left_wheel">
     <pose>0 0.18 0.05 0 1.5708 0</pose>

      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.00031</ixx>
          <iyy>0.00056</iyy>
          <izz>0.00031</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="left_wheel_visual">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>

      <collision name="left_wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>500000</kp>
              <kd>10</kd>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
    </link>

    <!--
      Joint axis: after rotating wheel by rpy="1.5708 0 0",
      the wheel's local Z becomes world Y.
      So spin axis in MODEL frame = "0 1 0"
      expressed_in="__model__" tells Gazebo axis is in model coords.
      limits = very large numbers = unlimited rotation (like continuous)
    -->
    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
          <effort>10</effort>
          <velocity>20</velocity>
        </limit>
        <dynamics>
          <damping>0.001</damping>
          <friction>0.0</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- ════════════════════════════════════════════════ -->
    <!--  RIGHT WHEEL                                     -->
    <!--  Mirror of left wheel: y = -0.175               -->
    <!-- ════════════════════════════════════════════════ -->
    <link name="right_wheel">
       <pose>0 0.18 0.05 0 1.5708 0</pose>

      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.00031</ixx>
          <iyy>0.00056</iyy>
          <izz>0.00031</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="right_wheel_visual">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>

      <collision name="right_wheel_collision">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>500000</kp>
              <kd>10</kd>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
    </link>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
          <effort>10</effort>
          <velocity>20</velocity>
        </limit>
        <dynamics>
          <damping>0.001</damping>
          <friction>0.0</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- ════════════════════════════════════════════════ -->
    <!--  CASTER WHEEL (front balance wheel)             -->
    <!--  Sphere shape - slides freely in any direction  -->
    <!--  Position: front of robot, touching ground      -->
    <!--  z = 0.025 (sphere radius = 0.025)              -->
    <!-- ════════════════════════════════════════════════ -->
    <link name="caster_link">
      <pose>0.17 0 0.03 0 0 0</pose>

      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.00004</ixx>
          <iyy>0.00004</iyy>
          <izz>0.00004</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="caster_visual">
        <geometry>
          <sphere><radius>0.025</radius></sphere>
        </geometry>
        <material>
          <ambient>0.6 0.6 0.6 1</ambient>
          <diffuse>0.6 0.6 0.6 1</diffuse>
        </material>
      </visual>

      <collision name="caster_collision">
        <geometry>
          <sphere><radius>0.025</radius></sphere>
        </geometry>
        <surface>
          <friction>
            <ode>
            <mu>0.0001</mu>
            <mu2>0.0001</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <joint name="caster_joint" type="fixed">
      <parent>base_link</parent>
      <child>caster_link</child>
    </joint>

    <!-- ════════════════════════════════════════════════ -->
    <!--  LIDAR SENSOR                                    -->
    <!--  Sits on top of body: z = 0.13 + 0.075 + 0.025 = 0.23 -->
    <!-- ════════════════════════════════════════════════ -->
    <link name="lidar_link">
      <pose>0 0 0.235 0 0 0</pose>

      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="lidar_visual">
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.9 0.1 0.1 1</ambient>
          <diffuse>0.9 0.1 0.1 1</diffuse>
        </material>
      </visual>

      <collision name="lidar_collision">
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.05</length>
          </cylinder>
        </geometry>
      </collision>

      <sensor name="lidar_sensor" type="gpu_lidar">
        <topic>scan</topic>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
        <always_on>true</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>

    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
    </joint>

    <!-- ════════════════════════════════════════════════ -->
    <!--  CAMERA SENSOR                                   -->
    <!--  Front of robot, same height as lidar           -->
    <!-- ════════════════════════════════════════════════ -->
    <link name="camera_link">
      <pose>0.20 0 0.21 0 0 0</pose>

      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="camera_visual">
        <geometry>
          <box><size>0.04 0.08 0.04</size></box>
        </geometry>
        <material>
          <ambient>0.1 0.8 0.1 1</ambient>
          <diffuse>0.1 0.8 0.1 1</diffuse>
        </material>
      </visual>

      <collision name="camera_collision">
        <geometry>
          <box><size>0.04 0.08 0.04</size></box>
        </geometry>
      </collision>

      <sensor name="camera_sensor" type="camera">
        <topic>camera/image_raw</topic>
        <update_rate>30</update_rate>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>15</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.005</stddev>
          </noise>
        </camera>
        <always_on>true</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>

    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

    <!-- ════════════════════════════════════════════════ -->
    <!--  DIFFERENTIAL DRIVE PLUGIN                       -->
    <!-- ════════════════════════════════════════════════ -->
    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.35</wheel_separation>
      <wheel_radius>0.05</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <min_velocity>-2</min_velocity>
      <max_velocity>2</max_velocity>
      <min_acceleration>-3</min_acceleration>
      <max_acceleration>3</max_acceleration>
    </plugin>

    <!-- ════════════════════════════════════════════════ -->
    <!--  JOINT STATE PUBLISHER                           -->
    <!-- ════════════════════════════════════════════════ -->
    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>

  </model>
</sdf>
